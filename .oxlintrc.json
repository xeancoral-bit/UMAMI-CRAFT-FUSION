{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".agents/**",
    "scratch/**",
    "data/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off",
    "react-hooks/exhaustive-deps": "off",
    "no-unused-vars": "off"
  }
}
