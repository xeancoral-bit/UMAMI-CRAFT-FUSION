{
  "name": "umami-craft-fusion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tunnel": "lt --port 3000",
    "kill:ports": "node scripts/kill-ports.js",
    "predev": "npm run kill:ports",
    "allow-firewall": "allow-firewall.bat",
    "dev:frontend": "vite",
    "dev:backend": "node --watch-path=server.js server.js",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "predev:umami": "npm run kill:ports",
    "dev:umami": "concurrently -k \"node --watch-path=server.js server.js --port 3001 --restaurant umami --frontend 3000\" \"vite --port 3000\"",
    "predev:bella": "npm run kill:ports",
    "dev:bella": "concurrently -k \"node --watch-path=server.js server.js --port 3002 --restaurant bella --frontend 3010\" \"vite --port 3010\"",
    "predev:verde": "npm run kill:ports",
    "dev:verde": "concurrently -k \"node --watch-path=server.js server.js --port 3003 --restaurant verde --frontend 3020\" \"vite --port 3020\"",
    "dev:suite": "concurrently --kill-others -n \"UMAMI-BE,UMAMI-FE,BELLA-BE,BELLA-FE,VERDE-BE,VERDE-FE\" -c \"red,red.dim,yellow,yellow.dim,green,green.dim\" \"node server.js --port 3001 --restaurant umami --frontend 3000 --mobile-frontend 3000\" \"vite --port 3000\" \"node server.js --port 3002 --restaurant bella --frontend 3010 --mobile-frontend 3000\" \"vite --port 3010\" \"node server.js --port 3003 --restaurant verde --frontend 3020 --mobile-frontend 3000\" \"vite --port 3020\"",
    "build": "vite build",
    "test": "node --check server.js && vite build",
    "start": "node server.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "localtunnel": "^2.0.2",
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0"
  }
}
