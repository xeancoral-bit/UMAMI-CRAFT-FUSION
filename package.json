{
  "name": "synapse-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:umami": "concurrently \"node server.js --port 3001 --restaurant umami --frontend 5173\" \"vite --port 5173\"",
    "dev:bella": "concurrently \"node server.js --port 3002 --restaurant bella --frontend 5174\" \"vite --port 5174\"",
    "dev:verde": "concurrently \"node server.js --port 3003 --restaurant verde --frontend 5175\" \"vite --port 5175\"",
    "dev:suite": "concurrently --kill-others -n \"UMAMI-BE,UMAMI-FE,BELLA-BE,BELLA-FE,VERDE-BE,VERDE-FE\" -c \"red,red.dim,yellow,yellow.dim,green,green.dim\" \"node server.js --port 3001 --restaurant umami --frontend 5173\" \"vite --port 5173\" \"node server.js --port 3002 --restaurant bella --frontend 5174\" \"vite --port 5174\" \"node server.js --port 3003 --restaurant verde --frontend 5175\" \"vite --port 5175\"",
    "build": "vite build",
    "start": "node server.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0"
  }
}
